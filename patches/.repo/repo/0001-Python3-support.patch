From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexander Koval <kovalidis@gmail.com>
Date: Wed, 14 Oct 2026 23:07:24 +0300
Subject: [PATCH 1/2] Python3 support

---
 git_config.py   |  2 +-
 main.py         |  2 +-
 subcmds/help.py | 14 +++++++++-----
 wrapper.py      | 14 ++++++++++++--
 4 files changed, 23 insertions(+), 9 deletions(-)

diff --git a/git_config.py b/git_config.py
index e223678..3c7d98e 100644
--- a/git_config.py
+++ b/git_config.py
@@ -296,7 +296,7 @@ class GitConfig(object):
     d = self._do('--null', '--list')
     if d is None:
       return c
-    for line in d.decode('utf-8').rstrip('\0').split('\0'):  # pylint: disable=W1401
+    for line in d.rstrip('\0').split('\0'):  # pylint: disable=W1401
                                                              # Backslash is not anomalous
       if '\n' in line:
         key, val = line.split('\n', 1)
diff --git a/main.py b/main.py
index c5f1e9c..840acd3 100755
--- a/main.py
+++ b/main.py
@@ -16,7 +16,6 @@
 
 from __future__ import print_function
 import getpass
-import imp
 import netrc
 import optparse
 import os
@@ -27,6 +26,7 @@ from pyversion import is_python3
 if is_python3():
   import urllib.request
 else:
+  import imp
   import urllib2
   urllib = imp.new_module('urllib')
   urllib.request = urllib2
