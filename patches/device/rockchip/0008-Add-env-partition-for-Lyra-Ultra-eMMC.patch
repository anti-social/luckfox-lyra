From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexander Koval <kovalidis@gmail.com>
Date: Wed, 25 Nov 2026 00:18:45 +0200
Subject: Add env partition for Lyra Ultra eMMC

Add a 512K env partition before rootfs on Lyra Ultra eMMC and install
fw_env.config pointing to it. Use a separate parameter file, since
parameter-lyra-emmc.txt is shared with other Lyra boards.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../luckfox_lyra_ultra_buildroot_emmc_defconfig     |  3 ++-
 .../rk3506/overlays/fw-env-emmc/etc/fw_env.config   |  3 +++
 .chips/rk3506/parameter-lyra-ultra-emmc.txt         | 13 +++++++++++++
 3 files changed, 18 insertions(+), 1 deletion(-)
 create mode 100644 .chips/rk3506/overlays/fw-env-emmc/etc/fw_env.config
 create mode 100644 .chips/rk3506/parameter-lyra-ultra-emmc.txt

diff --git a/.chips/rk3506/luckfox_lyra_ultra_buildroot_emmc_defconfig b/.chips/rk3506/luckfox_lyra_ultra_buildroot_emmc_defconfig
index cb1e072..ae6d05a 100644
--- a/.chips/rk3506/luckfox_lyra_ultra_buildroot_emmc_defconfig
+++ b/.chips/rk3506/luckfox_lyra_ultra_buildroot_emmc_defconfig
@@ -15,6 +15,7 @@ RK_KERNEL_DTS_NAME="rk3506b-luckfox-lyra-ultra"
 RK_BOOT_COMPRESSED=y
 # RK_RECOVERY is not set
 RK_EXTRA_PARTITION_NUM=0
-RK_PARAMETER="parameter-lyra-emmc.txt"
+RK_PARAMETER="parameter-lyra-ultra-emmc.txt"
 RK_USE_FIT_IMG=y
+RK_ROOTFS_EXTRA_OVERLAY_DIRS="fw-env-emmc"
 # RK_NETWORK_CHECK is not set
diff --git a/.chips/rk3506/overlays/fw-env-emmc/etc/fw_env.config b/.chips/rk3506/overlays/fw-env-emmc/etc/fw_env.config
new file mode 100644
index 0000000..f345676
--- /dev/null
+++ b/.chips/rk3506/overlays/fw-env-emmc/etc/fw_env.config
@@ -0,0 +1,3 @@
+# "env" partition from parameter-lyra-ultra-emmc.txt (512K, eMMC)
+# Device name			Device offset	Env. size
+/dev/block/by-name/env		0x0		0x40000
diff --git a/.chips/rk3506/parameter-lyra-ultra-emmc.txt b/.chips/rk3506/parameter-lyra-ultra-emmc.txt
new file mode 100644
index 0000000..10976ac
--- /dev/null
+++ b/.chips/rk3506/parameter-lyra-ultra-emmc.txt
@@ -0,0 +1,13 @@
+FIRMWARE_VER:8.1
+MACHINE_MODEL:RK3506
+MACHINE_ID:007
+MANUFACTURER: RK3506
+MAGIC: 0x5041524B
+ATAG: 0x00200800
+MACHINE: 3506
+CHECK_MASK: 0x80
+PWR_HLD: 0,0,A,0,1
+TYPE: GPT
+GROW_ALIGN: 0
+CMDLINE: mtdparts=rk29xxnand:0x00002000@0x00002000(uboot),0x00006000@0x00004000(boot),0x00000400@0x0000A000(env),-@0x00010000(rootfs:grow)
+uuid:rootfs=614e0000-0000-4b53-8000-1d28000054a9
