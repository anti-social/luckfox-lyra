diff --git a/common/overlays/rootfs/luckfox-lyra/S39macaddr b/common/overlays/rootfs/luckfox-lyra/S39macaddr
new file mode 100755
index 0000000..5e8cf78
--- /dev/null
+++ b/common/overlays/rootfs/luckfox-lyra/S39macaddr
@@ -0,0 +1,44 @@
+#!/bin/sh
+#
+# Keep Ethernet MAC addresses stable across reboots: the first boot saves the
+# (random) MAC of each interface to /etc/.<interface>_macaddr, later boots
+# restore it. Runs before S40network, so DHCP always sees the final MAC.
+
+restore_mac() {
+	iface="$1"
+	file="/etc/.${iface}_macaddr"
+
+	[ -e "/sys/class/net/$iface" ] || return 0
+
+	current=$(cat "/sys/class/net/$iface/address")
+	saved=$(cat "$file" 2>/dev/null)
+
+	if [ -z "$saved" ]; then
+		echo "$current" > "$file"
+		echo "Saved $iface MAC address $current"
+		return 0
+	fi
+
+	[ "$saved" = "$current" ] && return 0
+
+	if ip link show "$iface" | grep -q "[<,]UP[,>]"; then
+		ifconfig "$iface" down
+		ifconfig "$iface" hw ether "$saved"
+		ifconfig "$iface" up
+	else
+		ifconfig "$iface" hw ether "$saved"
+	fi
+	echo "Set $iface MAC address to $saved"
+}
+
+case "$1" in
+	start)
+		restore_mac eth0
+		restore_mac eth1
+		;;
+	stop|restart)
+		;;
+	*)
+		echo "Usage: $0 {start|stop|restart}"
+		exit 1
+esac
