From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexander Koval <kovalidis@gmail.com>
Date: Tue, 24 Nov 2026 23:11:03 +0200
Subject: Do not load all kernel modules at boot

S03modules_init.sh modprobes every module at boot, so drivers and
features like wireguard are loaded even when unused. Drop it: udev
loads drivers for present hardware and the kernel requests other
modules on demand.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../rootfs/luckfox-lyra/S03modules_init.sh    | 27 -------------------
 .../overlays/rootfs/luckfox-lyra/install.sh   |  2 --
 2 files changed, 29 deletions(-)
 delete mode 100755 common/overlays/rootfs/luckfox-lyra/S03modules_init.sh

diff --git a/common/overlays/rootfs/luckfox-lyra/S03modules_init.sh b/common/overlays/rootfs/luckfox-lyra/S03modules_init.sh
deleted file mode 100755
index 511cca9..0000000
--- a/common/overlays/rootfs/luckfox-lyra/S03modules_init.sh
+++ /dev/null
@@ -1,27 +0,0 @@
-#!/bin/sh
-#
-# Modules init
-#
-
-
-start() {
-	find /lib/modules/$(uname -r)/kernel/ -name "*.ko" | xargs -I {} sh -c 'modprobe $(basename {})'
-}
-
-stop() {
-	find /lib/modules/$(uname -r)/kernel/ -name "*.ko" | xargs -I {} sh -c 'modprobe -r $(basename {})'
-}
-
-case "$1" in
-	start)
-		start
-		;;
-	#stop)
-	#	stop
-	#	;;
-	*)
-		echo "Usage: $0 {start|stop|restart}"
-		exit 1
-esac
-
-exit $?
diff --git a/common/overlays/rootfs/luckfox-lyra/install.sh b/common/overlays/rootfs/luckfox-lyra/install.sh
index 123f2d6..ca7247d 100755
--- a/common/overlays/rootfs/luckfox-lyra/install.sh
+++ b/common/overlays/rootfs/luckfox-lyra/install.sh
@@ -9,12 +9,10 @@ OVERLAY_DIR="$(dirname "$(realpath "$0")")"
 
 $RK_RSYNC "$OVERLAY_DIR/etc" "$OVERLAY_DIR/usr" "$TARGET_DIR/"
 
-install_sysv_service "$OVERLAY_DIR/S03modules_init.sh" S
 install_sysv_service "$OVERLAY_DIR/S35wifibt-poweron.sh" S
 install_sysv_service "$OVERLAY_DIR/S35es8311" S
 install_sysv_service "$OVERLAY_DIR/S45usbconfig" S
 install_sysv_service "$OVERLAY_DIR/S60netdevice" S
-install_busybox_service "$OVERLAY_DIR/S03modules_init.sh"
 install_busybox_service "$OVERLAY_DIR/S35wifibt-poweron.sh"
 install_busybox_service "$OVERLAY_DIR/S35es8311"
 install_busybox_service "$OVERLAY_DIR/S45usbconfig"
