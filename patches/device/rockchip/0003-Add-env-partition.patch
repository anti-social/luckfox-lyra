+#!/bin/bash -e
+
+# Env image size, must match the "Env. size" in /etc/fw_env.config
+RK_ENV_SIZE="${RK_ENV_SIZE:-0x40000}"
+
+build_env()
+{
+	ENV_SRC_DIR="$RK_SDK_DIR/envs"
+	ENV_OUT_DIR="$RK_OUTDIR/env"
+	MKENVIMAGE="$RK_SDK_DIR/u-boot/tools/mkenvimage"
+
+	PART_SIZE="$(rk_partition_size env)"
+	if [ -z "$PART_SIZE" ]; then
+		error "No env partition in $RK_PARAMETER!"
+		return 1
+	fi
+
+	if [ $(( $RK_ENV_SIZE )) -gt $(( $PART_SIZE * 512 )) ]; then
+		error "Env size ($RK_ENV_SIZE) exceeds env partition!"
+		return 1
+	fi
+
+	if [ ! -x "$MKENVIMAGE" ]; then
+		error "$MKENVIMAGE not found, please build u-boot first!"
+		return 1
+	fi
+
+	if [ "$1" ]; then
+		ENV_FILES="$ENV_SRC_DIR/${1%.txt}.txt"
+	else
+		ENV_FILES="$(ls "$ENV_SRC_DIR"/*.txt 2>/dev/null || true)"
+	fi
+
+	if [ -z "$ENV_FILES" ]; then
+		error "No env files found in $ENV_SRC_DIR!"
+		return 1
+	fi
+
+	mkdir -p "$ENV_OUT_DIR"
+	for ENV_FILE in $ENV_FILES; do
+		if [ ! -r "$ENV_FILE" ]; then
+			error "$ENV_FILE not exists!"
+			return 1
+		fi
+
+		ENV_IMG="$ENV_OUT_DIR/$(basename "${ENV_FILE%.txt}").img"
+		"$MKENVIMAGE" -s "$RK_ENV_SIZE" -p 0x0 -o "$ENV_IMG" "$ENV_FILE"
+		notice "Done packing $ENV_IMG"
+	done
+
+	finish_build build_env $@
+}
+
+# Hooks
+
+usage_hook()
+{
+	usage_oneline "env[:<name>]" "pack env images from envs/*.txt (or envs/<name>.txt)"
+}
+
+clean_hook()
+{
+	rm -rf "$RK_OUTDIR/env"
+}
+
+BUILD_CMDS="env"
+build_hook()
+{
+	shift
+	build_env $@
+}
+
+source "${RK_BUILD_HELPER:-$(dirname "$(realpath "$0")")/../build-hooks/build-helper}"
+
+build_env $@
